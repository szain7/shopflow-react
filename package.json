{
  "name": "shopflow-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "practice": "node src/practice/practice.js",
    "test": "vitest",
    "practice:test": "node src/practice/test.js",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
